# ==============================================================================
# openEuler on Google Cloud (Compute Engine) 参数配置模板
# 使用方式：
#   cp env.example .env
#   修改下方带 <YOUR_...> 占位符的必填项，然后执行构建或验证脚本。
#   也可直接通过命令行参数（如 --project-id / --gcs-bucket）传入。
# ==============================================================================

# [必填] 目标 Google Cloud 项目 ID
PROJECT_ID="<YOUR_PROJECT_ID>"

# [必填] 用于暂存镜像归档文件 (.tar.gz) 的 Cloud Storage 存储桶名称（不含 gs:// 前缀）
# 若存储桶尚不存在，一键编排脚本可自动创建
GCS_BUCKET="<YOUR_GCS_BUCKET>"

# [必填] 临时构建机所在的可用区（例如 us-central1-a、asia-east1-b 等）
BUILD_ZONE="<YOUR_BUILD_ZONE>"

# [可选] 注册到 Compute Engine 的自定义镜像名称与镜像系列（Image Family）
IMAGE_NAME="openeuler-2203-sp4-gve-1-4-12"
IMAGE_FAMILY="openeuler-2203-lts"

# [可选] 构建机与测试机使用的 VPC 网络与子网名称
NETWORK="default"
SUBNET=""

# [可选] 临时构建机机型与启动盘大小
BUILDER_MACHINE_TYPE="n2-standard-8"
BUILDER_BOOT_DISK_GB="50"

# [可选] 是否为临时构建机/测试机分配外部公网 IP（true / false）
# 默认为 false（推荐企业环境：使用 --no-address 并通过 IAP 隧道连接 SSH，需目标区域已配置 Cloud NAT 出网）
# 若您的 VPC 未配置 Cloud NAT 且组织策略允许公网 IP，可设为 true，或将下方 ENSURE_CLOUD_NAT 设为 true
USE_EXTERNAL_IP="false"
ENSURE_CLOUD_NAT="false"
ENSURE_IAP_FIREWALL="false"

# [可选] 构建机使用的自定义服务账号邮箱（留空则使用项目默认 Compute Engine 服务账号）
BUILDER_SERVICE_ACCOUNT=""

# [可选] openEuler 基础镜像、目标内核版本、gVNIC 驱动版本与镜像盘大小（单位 GiB，必须为整数）
OE_QCOW2_URL="https://repo.openeuler.org/openEuler-22.03-LTS-SP4/virtual_machine_img/x86_64/openEuler-22.03-LTS-SP4-x86_64.qcow2.xz"
KVER="5.10.0-216.0.0.115.oe2203sp4.x86_64"
GVE_VERSION="v1.4.12"
DISK_SIZE_GB="10"

# [可选] 构建期间用于加速下载 RPM 包的 openEuler 镜像源（构建结束前会自动恢复系统默认官方源）
OE_MIRROR="https://mirrors.ocf.berkeley.edu/openeuler"

# [可选] 是否在锁定内核版本的前提下更新所有用户态安全补丁（true / false）
UPDATE_USERLAND="false"

# ==============================================================================
# 验收测试脚本 (scripts/verify_image.sh) 相关参数（仅在运行验收测试时使用）
# ==============================================================================

# [验证必填] 同时支持 N4（或 N4 + N4D）机型的目标可用区（例如 us-east4-b、us-central1-b 等）
VERIFY_ZONE="<YOUR_VERIFY_ZONE>"

# [验证可选] N4 与 N4D 测试实例规格与测试盘大小（用于验证 10 GiB -> 20 GiB 首启自动在线扩容）
N4_MACHINE_TYPE="n4-standard-4"
N4D_MACHINE_TYPE="n4d-standard-4"
VERIFY_BOOT_DISK_GB="20"

# [验证可选] 若目标可用区尚未开通 N4D，可将 SKIP_N4D 设为 true（此时将在两台 N4 实例间完成双向吞吐与负载均衡测试）
SKIP_N4D="false"
SKIP_ILB="false"
